# Copy to .env for local development. In production set these in the Render dashboard.
DEBUG=true
SECRET_KEY=change-me-to-a-long-random-string
SITE_URL=http://localhost:8000
ALLOWED_HOSTS=localhost,127.0.0.1
TIME_ZONE=America/New_York

# Online only: the dashboard has no login, so it lives at /d/<DASHBOARD_KEY>/. Keep it secret; bookmark it.
# DASHBOARD_KEY=

# Database (blank = local SQLite). Render sets DATABASE_URL automatically.
# DATABASE_URL=postgres://...

# Stripe (use test keys sk_test_... while developing). Webhook secret comes from
# `stripe listen` locally, or the Stripe dashboard webhook endpoint in production.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Email. DEBUG prints emails to the console. Production example (Resend SMTP):
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=smtp.resend.com
# EMAIL_PORT=587
# EMAIL_HOST_USER=resend
# EMAIL_HOST_PASSWORD=re_...
DEFAULT_FROM_EMAIL=Your Firm Plans <plans@yourfirm.com>
ENGINEER_NOTIFY_EMAIL=

# Private file storage. Off = ./private_files on disk. Production: Cloudflare R2.
USE_S3=false
# S3_BUCKET=plans-private
# S3_ENDPOINT_URL=https://<account-id>.r2.cloudflarestorage.com
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=

# Preview tuning
PREVIEW_DPI=100
PREVIEW_JPEG_QUALITY=70
# Blank out the seal/signature area on previews (fractions left,top,right,bottom). Empty = off.
PREVIEW_SEAL_BOX=
DELIVERY_GUARANTEE_HOURS=24
